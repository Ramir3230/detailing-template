# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# корнем сессии должна быть папка проекта, а не родительская
*.code-workspace

# claude code: агенты проекта в репозитории, локальные права — нет
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# исключение: пример без значений нужен в репозитории
!.env.example

# vercel
.vercel

# демо студий: своя папка со своим git (README, «Демо»); поставленное демо — копии
# заменённых файлов шаблона (npm run demo:use)
/demos/
/.demo-active/

# python: скрипт вырезки машины hero
__pycache__/
.venv/

# typescript
*.tsbuildinfo
next-env.d.ts
